# Optional: copy to .env yourself. Process environment takes precedence.
APP_ENV=local
# Docker host port (change if another project already uses 8501).
STREAMLIT_PORT=8501
# Leave CONFIG_PATH unset to let APP_ENV select config/local.yaml or config/gpu.yaml.
# CONFIG_PATH=config/local.yaml
# DEVICE=cpu
# WORKING_DOCUMENT_LIMIT=1000
# BATCH_SIZE=4
DATA_DIR=data
MODEL_DIR=models
CHECKPOINT_DIR=checkpoints
EXPERIMENT_DIR=experiments
REPORT_DIR=reports
